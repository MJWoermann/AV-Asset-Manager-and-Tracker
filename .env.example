APP_NAME="AV Asset Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production LAN: hostname/URL staff browsers resolve on corporate WiFi (PWA, API, SSO callbacks, guest QR).
# See docs/security-hardening.md (Corporate LAN / staff WiFi deployment).
# Optional UI commit label; defaults to short SHA from .git
# APP_VERSION=

# Public self-registration (default off). Production must stay false; create users via Admin or app:install.
ALLOW_REGISTRATION=false

# Guest Kanban stock QR surface (GET/POST /stock/t/{token}). Set false to disable without code deploy.
STOCK_GUEST_ENABLED=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For production MariaDB:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=av_assets
# DB_USERNAME=av_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Attachment library disk: local | qnap | sharepoint
ATTACHMENTS_DISK=local
# Optional remote target for php artisan app:backup (same allow-list as attachments)
# BACKUP_DISK=qnap

# QNAP / NAS — one disk name; switch mode with QNAP_DRIVER=mount|sftp|s3
# QNAP_DRIVER=mount
# QNAP_MOUNT_PATH=/mnt/qnap/av-assets
# QNAP_THROW=true
# QNAP_SFTP_HOST=
# QNAP_SFTP_PORT=22
# QNAP_SFTP_USERNAME=
# QNAP_SFTP_PASSWORD=
# QNAP_SFTP_PRIVATE_KEY=
# QNAP_SFTP_PASSPHRASE=
# QNAP_SFTP_ROOT=/
# QNAP_SFTP_TIMEOUT=30
# QuObjects / S3-compatible on QNAP:
# QNAP_S3_ACCESS_KEY_ID=
# QNAP_S3_SECRET_ACCESS_KEY=
# QNAP_S3_REGION=us-east-1
# QNAP_S3_BUCKET=
# QNAP_S3_ENDPOINT=https://nas.example.com:8080
# QNAP_S3_URL=
# QNAP_S3_USE_PATH_STYLE_ENDPOINT=true
# QNAP_S3_ROOT=

# SharePoint (Microsoft Graph app-only) — needs Files.ReadWrite.All or Sites.ReadWrite.All + admin consent
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_TENANT_ID=
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_ROOT_ITEM_ID=
# SHAREPOINT_PREFIX=AV-Asset-Manager/attachments
# SHAREPOINT_THROW=true

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Email integration (optional) — see docs/email-setup.md
# Enable per-user developer feature "Email integration", then Admin → Email.
# Secrets stay here; never paste passwords into the database UI.
# ---------------------------------------------------------------------------

# --- Gmail (driver: gmail) — App Password after 2FA ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM_ADDRESS="you@example.com"
# MAIL_FROM_NAME="${APP_NAME}"
# IMAP presets (imap.gmail.com:993 SSL) are applied in-app when driver=gmail.

# --- Outlook / Microsoft 365 Graph (driver: outlook) ---
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# MICROSOFT_GRAPH_TENANT_ID=
# Prefer these over reusing AZURE_* SSO credentials (mail needs Mail.Send / Mail.Read).
# Set mailbox UPN in Admin → Email.

# --- Manual SMTP (+ optional IMAP in Admin → Email) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth SSO (credentials only; toggles and domain whitelist are in Admin → SSO)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_REDIRECT_URI="${APP_URL}/auth/azure/callback"
# AZURE_TENANT_ID=
